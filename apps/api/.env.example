# Copia este archivo como .env y ajusta usuario/contraseña.
# Requiere autenticación SQL (no Windows) y TCP habilitado en el puerto indicado.
DATABASE_URL="sqlserver://localhost:1433;database=kanban;user=kanban_app;password=CambiaEsto123!;encrypt=true;trustServerCertificate=true"

PORT=3000
# Origen del front (Vite) permitido por CORS
WEB_ORIGIN=http://localhost:5173

# Secreto para firmar las sesiones (JWT). Mínimo 32 caracteres, aleatorio y privado.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=reemplaza-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
