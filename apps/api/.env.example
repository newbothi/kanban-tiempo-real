# Copia este archivo como .env y ajusta usuario/contraseña.
# Requiere autenticación SQL (no Windows) y TCP habilitado en el puerto indicado.
DATABASE_URL="sqlserver://localhost:1433;database=kanban;user=kanban_app;password=CambiaEsto123!;encrypt=true;trustServerCertificate=true"

PORT=3000
# Origen del front (Vite) permitido por CORS y por el WebSocket. En producción la web y la API
# comparten origen: déjalo sin definir y no se habilita CORS.
WEB_ORIGIN=http://localhost:5173

# Secreto para firmar las sesiones (JWT). Mínimo 32 caracteres, aleatorio y privado.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (Sin valor a propósito: si copias un valor de ejemplo, cualquiera podría falsificar sesiones.)
JWT_SECRET=

# Servicio de análisis (Python). En local: uvicorn en el puerto 8000.
ML_URL=http://localhost:8000
# Secreto compartido con el servicio ML (mismo valor en ambos lados). Opcional en desarrollo;
# en producción es obligatorio (mínimo 32 caracteres) o la API no arranca.
ML_TOKEN=

# Verificación de correo (opcional). Con ambas variables se envían los correos con Resend
# y se exige confirmar el correo para ver y aceptar invitaciones; sin ellas no se exige.
RESEND_API_KEY=
MAIL_FROM=
# URL pública de la app para los enlaces de los correos (por defecto, la del request).
PUBLIC_URL=

# Otros (opcionales): correo de la cuenta demo restringida, saltos de proxy de confianza
# (1 en producción detrás de Azure) y permiso para correr seed/simulación contra producción.
# DEMO_EMAIL=demo@kanban.cl
# TRUST_PROXY_HOPS=1
# ALLOW_PROD_SEED=1
